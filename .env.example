# Токен бота от @BotFather
BOT_TOKEN=123456789:replace_with_your_bot_token

# Username администраторов через запятую. @ можно указывать или не указывать.
# У каждого администратора должен быть установлен публичный Telegram username.
ADMIN_USERNAMES=your_username,another_admin

# Исходные тексты. После изменения через админку используются значения из SQLite.
WELCOME_MESSAGE="Привет, это сообщение 1 (старт). Его может поменять админ бота"
BUTTON_1_TEXT=Да
ANSWER_1_MESSAGE="Это сообщение 2 (Да) - реакция на кнопку 1. Его может поменять админ бота"
BUTTON_2_TEXT=Нет
ANSWER_2_MESSAGE="Это сообщение 3 (Нет) - реакция на кнопку 2. Его может поменять админ бота"

DB_PATH=/app/data/bot.db

